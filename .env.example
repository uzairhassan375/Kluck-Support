# Public — Kluck API (credits + PostHog excluded stores)
VITE_API_URL=https://api.kluck.ai

# Server-only on Vercel (Market flow stats tab). Do NOT prefix with VITE_.
# Create a Personal API key in PostHog → Settings → Personal API keys (query access).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=296750
POSTHOG_HOST=https://us.posthog.com

# REQUIRED for Market flow stats — same value as Fly/API (token HMAC secret).
# Prefer SUPPORT_ADMIN_TOKEN_SECRET; if the API only has SUPPORT_ADMIN_PASSWORD, set that here too.
SUPPORT_ADMIN_TOKEN_SECRET=
# SUPPORT_ADMIN_PASSWORD=
